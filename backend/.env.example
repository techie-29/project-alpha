PORT=5000
DB_HOST=localhost
DB_USER=project_alpha_user
DB_PASSWORD=replace_with_your_password
DB_NAME=project_alpha
JWT_SECRET=replace_with_a_long_random_secret

# --- Alpha engine (Python service) ---
# Address of the engine; it should listen on 127.0.0.1 only.
ENGINE_URL=http://127.0.0.1:8001
# Shared secret between this backend and the engine. Use the same value in engine/.env
ENGINE_API_KEY=replace_with_a_long_random_key
# Folder where uploaded files are stored (the engine only reads files inside this folder)
UPLOAD_DIR=./uploads
# Largest single upload in megabytes
ALPHA_MAX_FILE_MB=100
