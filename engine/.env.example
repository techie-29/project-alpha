# Copy to engine/.env and fill in. This file is never committed.
# Must be the same value as ENGINE_API_KEY in backend/.env
ENGINE_API_KEY=replace_with_a_long_random_key
# Absolute path of the backend uploads folder (the engine only reads files inside it)
ENGINE_UPLOAD_DIR=/absolute/path/to/project-alpha/backend/uploads
# Where finished reports and saved analysis data are kept
ENGINE_DATA_DIR=/absolute/path/to/project-alpha/engine/engine_data
# OpenRouter key (DeepSeek etc.) - used first if set
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
# Or a Gemini key (leave empty to run without the AI helper)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Limits per analysis (the AI stops and the report uses what it has): number of calls, and dollars
AI_MAX_CALLS=60
AI_MAX_COST_USD=0.50
# Longest answer the AI may write (lower it if OpenRouter says you can only afford fewer tokens)
AI_MAX_TOKENS=8192
# Optional: low | medium | high thinking effort for models that support it (costs more)
# AI_REASONING=low
# 1 = the same upload replays the saved AI run (no cost, same report); 0 = always ask the AI again
AI_REPLAY=1
